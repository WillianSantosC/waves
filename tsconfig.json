{
  "compilerOptions": {
    // Environment
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["bun"],

    // Bundler / Bun
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // Strictness
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,

    // Project policy
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // apps/*/src and packages/*/src are typechecked individually via each
  // package's own `tsc --noEmit` (see each package's `typecheck` script),
  // since only their local tsconfig.json has the correct `@/*` alias target.
  // Each package's tsconfig.json fully overrides `include` (not merged), so
  // this only governs the root-level compile itself.
  "include": ["scripts", "tests", "*.ts"],
  "exclude": ["node_modules"]
}
