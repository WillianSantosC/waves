{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["clear-text", "progress", "html"],
  "mutate": ["apps/*/src/**/*.ts", "packages/*/src/**/*.ts", "!**/*.test.ts", "!**/*.d.ts"],
  "ignoreStatic": true,
  "inPlace": true,
  "concurrency": 1
}
